# Kart — Dokploy / VPS environment
# Copy these into Dokploy → Application → Environment, or:
#   cp .env.example .env
# then fill in the values. `npm start` loads this file, creates the
# database if it is missing, and applies migrations/*.sql automatically.
#
# Existing process environment (Dokploy UI, systemd) always wins over this file.

# --- required ---------------------------------------------------------------
# Postgres connection string. The database name in the path is created if it
# does not exist (the role needs CREATEDB, which Dokploy's Postgres user has).
#
# Same-project Dokploy Postgres (internal hostname = the database service name):
# DATABASE_URL=postgresql://kart:secret@kart-postgres:5432/kart
#
# Neon / any host that requires TLS:
# DATABASE_URL=postgresql://user:pass@host:5432/kart?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kart

# Public origin. Leave empty to default to https://shop.sifalo.cloud.
# Set this if the app is served on a different host.
BETTER_AUTH_URL=https://shop.sifalo.cloud

# Session signing secret — 32+ random bytes.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# --- recommended ------------------------------------------------------------
# Must be available at BUILD time so the client bundle includes sign-in.
VITE_AUTH_ENABLED=true

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Nitro must emit a Node server for Dokploy (not the Vercel preset).
NITRO_PRESET=node-server

# Railpack: keep this as a Node server, not a static Vite site.
RAILPACK_NO_SPA=1

# Optional. Extra emails that can open /dashx (hidden owner console).
# The first boot also creates owner@shop.sifalo.cloud and prints the password
# in deploy logs. Set DASHX_RESET_PASSWORD=1 once to rotate it.
# DASHX_ADMIN_EMAIL=owner@shop.sifalo.cloud
# PLATFORM_ADMIN_EMAILS=you@sifalo.cloud

# Fallback country when the request has no CF-IPCountry (or similar) header.
# Shops inherit this on create. ISO 3166-1 alpha-2.
# DEFAULT_SIGNUP_COUNTRY=SO

# --- social login (optional) ------------------------------------------------
# Each provider appears on /login ONLY when BOTH client id and secret are set.
# Restart the app after changing these. Callback URL is:
#   {BETTER_AUTH_URL}/api/auth/callback/{provider}
# Details: README.md → Social login.
#
# Google (Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID, Web)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# GitHub (github.com/settings/developers → OAuth Apps)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# X (developer.x.com → OAuth 2.0 confidential client)
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
#
# Discord (discord.com/developers/applications → OAuth2)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
#
# Facebook (developers.facebook.com → Facebook Login)
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
#
# Apple (developer.apple.com Services ID + JWT client secret)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
#
# Microsoft (portal.azure.com app registration)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# --- optional: S3 / R2 (prefer configuring in /dashx → Storage) -------------
# S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=kart-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_CDN_BASE=https://cdn.example.com
# S3_FORCE_PATH_STYLE=1

# --- optional: Sifalo Pay (prefer configuring in /dashx → Payments) ---------
# SIFALO_GATEWAY_URL=https://api.sifalopay.com/gateway/
# SIFALO_VERIFY_URL=https://api.sifalopay.com/gateway/verify.php
# SIFALO_CHECKOUT_PAGE=https://pay.sifalo.com/checkout/
# SIFALO_API_KEY=
# SIFALO_API_PASSWORD=

# --- optional Grok broker (sandbox preview Google/X; not needed on Dokploy) -
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# VITE_GROK_OAUTH=true
