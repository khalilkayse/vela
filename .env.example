# Vela — Dokploy / VPS environment
# Copy these into Dokploy → Application → Environment, or:
#   cp .env.example .env
# then fill in the values. `npm start` loads this file, creates the
# database if it is missing, and applies migrations/*.sql automatically.
#
# Existing process environment (Dokploy UI, systemd) always wins over this file.

# --- required ---------------------------------------------------------------
# Postgres connection string. The database name in the path is created if it
# does not exist (the role needs CREATEDB, which Dokploy's Postgres user has).
#
# Same-project Dokploy Postgres (internal hostname = the database service name):
# DATABASE_URL=postgresql://vela:secret@vela-postgres:5432/vela
#
# Neon / any host that requires TLS:
# DATABASE_URL=postgresql://user:pass@host:5432/vela?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vela

# Public origin of this app (no trailing slash). Used by Better Auth cookies
# and OAuth callbacks.
BETTER_AUTH_URL=https://vela.example.com

# Session signing secret — 32+ random bytes.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# --- recommended ------------------------------------------------------------
# Must be available at BUILD time so the client bundle includes sign-in.
VITE_AUTH_ENABLED=true

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Nitro must emit a Node server for Dokploy (not the Vercel preset).
NITRO_PRESET=node-server

# Railpack: keep this as a Node server, not a static Vite site.
RAILPACK_NO_SPA=1

# --- optional Grok broker (only if you federate Google / X sign-in) ---------
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
